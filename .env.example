# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp webhook verification (any random string you choose)
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Flow IDs (from Meta Business Suite after creating Flows)
LANG_FLOW_ID=
CROP_FLOW_ID=

# Gemini API (Google AI Studio — free, no credit card)
GEMINI_API_KEY=

# data.gov.in (register at data.gov.in → My Account → API key)
AGMARKET_KEY=

# OpenCage geocoding (opencagedata.com — free tier)
OPENCAGE_KEY=

# Upstash Redis (console.upstash.com → REST API tab)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transport cost in INR per km per quintal
TRANSPORT_COST_PER_KM=2
